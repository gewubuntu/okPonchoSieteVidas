{
  "name": "poncho-siete-vidas",
  "private": true,
  "version": "0.0.0",
  "description": "PONCHO: Siete Vidas - a platformer starring a cat in a Mexican poncho",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:abilities": "vitest run -c vitest.abilities.config.ts",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "check": "node scripts/check.mjs",
    "shots": "playwright test --project=shots-desktop --project=shots-phone"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
