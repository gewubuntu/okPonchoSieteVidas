{
  "name": "poncho-siete-vidas",
  "private": true,
  "version": "0.0.0",
  "description": "PONCHO: Siete Vidas - a platformer starring a cat in a Mexican poncho",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:abilities": "vitest run -c vitest.abilities.config.ts",
    "test:glide": "vitest run -c vitest.glide.config.ts",
    "test:sight": "vitest run -c vitest.sight.config.ts",
    "server:build": "vite build --ssr server/main.ts --outDir server/dist --emptyOutDir",
    "server": "npm run server:build && node server/dist/main.js",
    "server:check": "npm run server:build && node server/dist/main.js --check && node scripts/server-log-check.mjs",
    "test:e2e": "playwright test --project=desktop --project=phone",
    "check": "node scripts/check.mjs",
    "shots": "playwright test --project=shots-desktop --project=shots-phone"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "viem": "^2.58.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
