# The game's own web server inside its image (GDD-TEC-08, Dockerfile). Plain HTTP on port 80: the edge Caddy
# (deploy/Caddyfile) terminates HTTPS and compresses.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	file_server {
		# The deploy's list of an image's own hashed files (docs/deploy.md), not part of the game.
		hide .release-files
	}

	# Vite names built files by their content hash: cache them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html names the current bundles: always revalidate it.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	header -Server
}
